<div>
  <div>
    <nav aria-label="breadcrumb">
      <ul>
        <li>Home</li>
      </ul>
    </nav>
  </div>
</div>

<div>
  <article>
    <header>All boards</header>
    <ul>
      <% @list_of_boards.each do |a_board| %>
        <li>
          <a href="/boards/<%= a_board.id %>">
            <%= a_board.name %>
          </a>
        </li>
      <% end %>
    </ul>
  </article>
</div>

<div>
  <article>
    <header>
      Add a new board
    </header>

    <form action="/insert_board" method="post">
      <div>
        <label for="name_box">
          Name
        </label>

        <input type="text" id="name_box" name="query_name" placeholder="Enter a name for your board">
      </div>

      <button>
        Add board
      </button>
    </form>
  </article>
</div>
