<div>
  <div>
    <nav aria-label="breadcrumb">
      <ul>
        <li>
          <a href="/">Home</a>
        </li>
        <li><%= @the_board.name %></li>
      </ul>
    </nav>
  </div>
</div>

<div>
  <article>
    <header>Active Posts</header>
    <table>
      <thead>
        <tr>
          <th>Title</th>
          <th>Body</th>
          <th>Posted on</th>
          <th>Expires on</th>
        </tr>
      </thead>
      <tbody>
        <% @the_board.active_posts.order({:expires_on => :asc}).each do |active_post|%>
          <tr>
            <td><%= active_post.title %></td>
            <td><%= active_post.body %></td>
            <td><%= active_post.created_at.strftime("%b %e, %Y") %></td>
            <td><%= active_post.expires_on.strftime("%b %e, %Y") %></td>
          </tr>
        <%end%>
      </tbody>
    </table>
  </article>
</div>

<article>
  <div>
    <div>
      <header>Add a new post</header>

      <form action="/insert_post"  method="post" >
        <div>
          <label for="title_box">
            Title
          </label>

          <input type="text" id="title_box" name="query_title" placeholder="Enter a title for the post">
        </div>

        <div>
          <label for="body_box">
            Body
          </label>

          <textarea id="body_box" name="query_body" placeholder="Enter a body for the post"></textarea>
        </div>

        <div>
          <label for="expires_on_box">
            Expires on
          </label>

          <input type="date" id="expires_on_box" name="query_expires_on" >
        </div>

        <div>
          <input type="hidden" id="board_id_box" name="query_board_id" value="<%= @the_board.id %>">
        </div>

        <button>
          Add post
        </button>
      </form>
    </div>
  </div>
</article>

<div>
  <article>
    <header>Expired Posts</header>
    <table>
      <thead>
        <tr>
          <th>Title</th>
          <th>Body</th>
          <th>Posted on</th>
          <th>Expires on</th>
        </tr>
      </thead>
      <tbody>
        <% @the_board.expired_posts.each do |expired_post|%>
          <tr>
            <td><%= expired_post.title %></td>
            <td><%= expired_post.body %></td>
            <td><%= expired_post.created_at.strftime("%b %e, %Y") %></td>
            <td><%= expired_post.expires_on.strftime("%b %e, %Y") %></td>
          </tr>
        <%end%>
      </tbody>
    </table>
  </article>
</div>
